{
  "name": "freewind-debug-bridge-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host --open",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "tsp compile typespec",
    "generate:types": "openapi-typescript typespec/generated/openapi.yaml -o src/generated/api-types.ts --root-types --root-types-no-schema-prefix",
    "generate": "pnpm generate:openapi && pnpm generate:types",
    "build": "pnpm generate && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "ahooks": "^3.9.7",
    "antd": "^6.4.3",
    "freewind-ts-utils": "github:freewind/freewind-ts-utils#v0.2.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-json-view-lite": "^2.5.0",
    "use-context-selector": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typespec/compiler": "^1.12.0",
    "@typespec/http": "^1.12.0",
    "@typespec/openapi3": "^1.12.0",
    "@typespec/rest": "^0.82.0",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.60.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.19"
  }
}
